# Application Settings
APP_NAME="LLM Evaluation & Benchmarking Platform"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=llm_eval_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/llm_eval_db

# LLM Provider Configuration (Optional for initial development)
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Observability Configuration (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
